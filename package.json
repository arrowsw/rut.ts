{
  "name": "rut.ts",
  "version": "5.0.0",
  "type": "module",
  "description": "Handle chilean RUT values with ease.",
  "author": "arrowsw",
  "sideEffects": false,
  "main": "./dist/cjs/index.min.js",
  "module": "./dist/esm/index.min.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.min.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.min.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && node scripts/postbuild.mjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs",
    "lint": "eslint \"{**/*,*}.{js,ts,jsx,tsx}\"",
    "prettier": "prettier --write \"{src,tests,example/src}/**/*.{js,ts,jsx,tsx}\"",
    "test": "jest --config jest.config.cjs",
    "test:differential": "RUN_DIFFERENTIAL=1 jest --config jest.config.cjs tests/differential.test.ts",
    "size": "size-limit",
    "mutation": "stryker run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test && npm run prettier && npm run lint"
  },
  "license": "MIT",
  "devDependencies": {
    "@size-limit/file": "12.1.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/jest-runner": "9.6.1",
    "@types/jest": "30.0.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "expect-type": "1.3.0",
    "fast-check": "4.8.0",
    "jest": "30.2.0",
    "prettier": "3.8.1",
    "size-limit": "12.1.0",
    "terser": "5.46.0",
    "ts-jest": "29.4.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1"
  },
  "engines": {
    "node": ">=14"
  },
  "homepage": "https://rut.arrowsw.com",
  "keywords": [
    "validation",
    "check",
    "verifierDigit",
    "digito verificador",
    "dv",
    "modulo 11",
    "chilean",
    "chile",
    "rut",
    "run",
    "rut chileno",
    "formatting",
    "node",
    "browser",
    "typescript",
    "generate",
    "deconstruct"
  ],
  "repository": {
    "url": "https://github.com/arrowsw/rut.ts.git",
    "type": "git"
  },
  "bugs": {
    "url": "https://github.com/arrowsw/rut.ts/issues"
  },
  "files": [
    "dist/**/*.min.js",
    "dist/**/*.min.js.map",
    "dist/**/*.d.ts",
    "dist/cjs/package.json",
    "src/**/*.ts",
    "LICENSE",
    "README.md",
    "llms.txt"
  ]
}
